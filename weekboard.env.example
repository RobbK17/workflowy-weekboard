# Secrets and settings for the Workflowy Week Board on your own server (DEPLOY_MODE=vps).
#
# Install it OUTSIDE the project folder, readable only by root:
#   sudo cp weekboard.env.example /etc/weekboard.env
#   sudo chown root:root /etc/weekboard.env
#   sudo chmod 600 /etc/weekboard.env
#   sudo nano /etc/weekboard.env
#
# Format: NAME=value, one per line, no spaces around the =. Quotes are optional.
# Do not put this file in git.

DEPLOY_MODE=vps

# From https://workflowy.com/api-key
WORKFLOWY_API_KEY=

# The password you sign in with. At least 12 characters. Make one with:  openssl rand -base64 24
BOARD_PASSWORD=

# The https:// address you will visit (the same name you put in the Caddyfile).
PUBLIC_URL=https://board.example.com

# The app only listens on this machine; Caddy passes requests to it.
PORT=3000

# Reminders (v1.2.0). Set the time zone so "@2:30pm" means your 2:30pm, not the server's (UTC).
# Names look like America/New_York, Europe/London, Asia/Tokyo.
REMINDER_TZ=America/New_York

# Push reminders to your phone when the board is closed. Use ntfy, Pushover, or both. Leave all blank to skip push
# (popups in the board still work). See "Reminders" in README.md for the step-by-step setup.
#
# ntfy (free): install the ntfy app, subscribe to a topic with a long random name, and put the same name here.
# Anyone who knows the topic name can read your reminders, so treat it like a password.
# NTFY_TOPIC=weekboard-change-this-to-something-long-and-random
# Your own ntfy server instead of ntfy.sh (and its access token, if it needs one):
# NTFY_URL=https://ntfy.example.com
# NTFY_TOKEN=
#
# Pushover (paid, one-time fee): your User Key from the dashboard and an application token from pushover.net/apps/build.
# PUSHOVER_USER=
# PUSHOVER_TOKEN=

# Optional
# REMINDER_NESTED=0                                  # 0 = push reminders ignore tasks nested under a bullet (fewer WorkFlowy requests)
# REMINDER_STATE=/var/lib/weekboard/reminders-sent.json   # where sent push reminders are remembered (default: system temp folder, which a reboot may clear)
# NOTES_NAME=WB-Notes
# IDLE_PURGE_MINUTES=10
# SESSION_DAYS=7
# UPDATE_CHECK=1
